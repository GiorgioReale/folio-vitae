<body id="homepage">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  
<aside></aside>

  <section>
    <header>
      <nav>
        
        <div class="language-switcher" role="navigation" aria-label="Language">
          
          
          
          <span class="language-switcher__current" lang="en" aria-current="page">
            <span aria-hidden="true">en</span>
            <span class="sr-only">Language: English (Current language)</span>
          </span>
          
          
          
          
          <a href="&#x2F;it&#x2F;" lang="it" aria-label="Language: italiano" title="Language: italiano">
            <span aria-hidden="true">it</span>
            <span class="sr-only">Language: italiano</span>
          </a>
          
          
        </div>
        
        <a href="/en/" aria-label="Home" title="Home">
          <svg aria-hidden="true" focusable="false">
            <use xlink:href="/assets/icons/cv/website/sprites.svg#home" />
          </svg>
        </a>
        <button type="button" id="theme-switch" aria-label="Light&#x2F;Dark Mode"
          title="Light&#x2F;Dark Mode">
          <svg aria-hidden="true" focusable="false">
            <use xlink:href="/assets/icons/cv/website/sprites.svg#moon-auto" />
          </svg>
        </button>
        <a href="/en/menu" id="menu" aria-label="Menu" title="Menu">
          <svg aria-hidden="true" focusable="false">
            <use xlink:href="/assets/icons/cv/website/sprites.svg#menu" />
          </svg>
        </a>
      </nav>
    </header>
    
<main id="main-content" tabindex="-1">
  <h1>Alex Carter</h1>
  <h2>Full Stack Developer</h2>
  <a href="/en/curriculum" aria-label="Curriculum">
    <svg aria-hidden="true" focusable="false">
      <use xlink:href="/assets/icons/cv/website/sprites.svg#right-arrow" />
    </svg>
    <span class="sr-only">Go to the curriculum</span>
  </a>
</main>

    <footer>
      <p>
        <svg aria-hidden="true" focusable="false">
          <use xlink:href="/assets/icons/cv/website/sprites.svg#copyright" />
        </svg>
        
        CURRENT_YEAR - <a href="https://alexcarter.dev" target="_blank" rel="noopener noreferrer">Alex Carter</a>
        
      </p>
      
      <p>
        &#60;&#47;&#62; with
        <svg aria-hidden="true" focusable="false">
