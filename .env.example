# You can leave most of this file empty.
# The app already has sensible defaults for local development.

# Environment
# Default: development
# APP_ENV=production

# Data directory
# Default: ./data
# Use this only if your content lives somewhere else.
# DATA_DIR=/absolute/path/to/data

# Default language fallback for unprefixed URLs (/ , /curriculum, …)
# Priority: browser Accept-Language → DEFAULT_LANGUAGE → en (if available) → first language.
# DEFAULT_LANGUAGE=it

# Local servers
# Default main site port: 36546
# MAIN_PORT=3000

# Default CV site port: 36547
# CV_PORT=3001

# Footer credits
# Default: true
# Set to false to hide credits.
# CREDITS=false

# Trusted reverse proxies for X-Forwarded-Proto (optional)
# Loopback (127.0.0.1 / ::1) is always trusted. Set this only if your proxy
# runs on another host and should be allowed to mark requests as HTTPS.
# Comma-separated IP addresses (no CIDR).
# TRUSTED_PROXIES=10.0.0.5,2001:db8::1

# Email for the CV contact form (optional)
# Enabled when all of SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, and SMTP_FROM are set.
# The binary includes SMTP support by default (feature `smtp`).
# SMTP_PORT defaults to 587 when omitted.
# SMTP_HOST=smtp.example.com
# Port 465 = implicit TLS (recommended). Port 587 = STARTTLS.
# SMTP_PORT=465
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# SMTP_FROM=no-reply@example.com
