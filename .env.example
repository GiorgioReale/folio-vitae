# You can leave most of this file empty.
# The app already has sensible defaults for local development.

# Environment
# Default: development
# APP_ENV=production

# Data directory
# Default: ./data
# Use this only if your content lives somewhere else.
# DATA_DIR=/absolute/path/to/data

# Default language
# Default: en when available, otherwise the first detected language.
# DEFAULT_LANGUAGE=it

# Local servers
# Default main site port: 8080
# MAIN_PORT=3000

# Default CV site port: 8081
# CV_PORT=3001

# Footer credits
# Default: true
# Set to false to hide credits.
# CREDITS=false

# Email for the CV contact form (optional)
# If SMTP is not configured, email sending stays disabled.
# SMTP_PORT defaults to 587 when omitted.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# SMTP_FROM=no-reply@example.com
